source "https://rubygems.org"

# Jekyll and the plugins used by this site (the Minimal Mistakes theme files
# live locally in this repo, so the theme gem itself is not required).
gem "jekyll", ">= 3.7", "< 5.0"
gem "jekyll-paginate"
gem "jekyll-sitemap"
gem "jekyll-gist"
gem "jekyll-feed"
gem "jekyll-include-cache"

# Required to run `jekyll serve` on Ruby 3.0+ (webrick was removed from stdlib).
gem "webrick"
